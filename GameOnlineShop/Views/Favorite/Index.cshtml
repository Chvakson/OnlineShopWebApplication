@model List<ProductViewModel>
@{
    ViewData["Title"] = "Избранное";
}

<section class="page-section">
    <h1>Избранное</h1>
    @if (Model == null || Model.Count == 0)
    {
        <div class="empty-state">
            <h3>Пока пусто</h3>
            <p>Добавляйте игры в избранное, чтобы быстро находить их позже.</p>
            <a class="btn-shop" asp-area="" asp-controller="Home" asp-action="Index">Открыть каталог</a>
        </div>
    }
    else
    {
        <div class="game-grid">
            @foreach (var product in Model)
            {
                ViewData["CardVariant"] = "favorite";
                @await Html.PartialAsync("_ProductCard", product)
            }
        </div>
    }
</section>
