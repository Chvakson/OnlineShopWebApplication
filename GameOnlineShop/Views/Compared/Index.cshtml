@model List<ProductViewModel>
@{
    ViewData["Title"] = "Сравнение";
}

<section class="page-section">
    <h1>Сравнение игр</h1>
    @if (Model == null || Model.Count == 0)
    {
        <div class="empty-state">
            <h3>Нечего сравнивать</h3>
            <p>Добавьте несколько игр из каталога, чтобы сравнить жанр, студию и год выхода.</p>
            <a class="btn-shop" asp-area="" asp-controller="Home" asp-action="Index">Открыть каталог</a>
        </div>
    }
    else
    {
        <div class="compare-track">
            @foreach (var product in Model)
            {
                ViewData["CardVariant"] = "compared";
                @await Html.PartialAsync("_ProductCard", product)
            }
        </div>

        <div class="compare-table-wrap">
            <table class="compare-table">
                <thead>
                    <tr>
                        <th>Характеристика</th>
                        @foreach (var product in Model)
                        {
                            <th>@product.Name</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <th>Жанр</th>
                        @foreach (var product in Model)
                        {
                            <td>
                                <div class="hero-tags">
                                    @foreach (var tag in product.GenreTags)
                                    {
                                        <span class="genre-tag" data-genre="@tag">@tag</span>
                                    }
                                    @if (!product.GenreTags.Any())
                                    {
                                        <span class="muted">—</span>
                                    }
                                </div>
                            </td>
                        }
                    </tr>
                    <tr>
                        <th>Год издания</th>
                        @foreach (var product in Model)
                        {
                            <td>@(product.ReleaseYear?.ToString() ?? "—")</td>
                        }
                    </tr>
                    <tr>
                        <th>Студия-разработчик</th>
                        @foreach (var product in Model)
                        {
                            <td>@(string.IsNullOrWhiteSpace(product.Developer) ? "—" : product.Developer)</td>
                        }
                    </tr>
                    <tr>
                        <th>Цена</th>
                        @foreach (var product in Model)
                        {
                            <td class="compare-price">@product.Cost.ToString("N0") ₽</td>
                        }
                    </tr>
                </tbody>
            </table>
        </div>
    }
</section>
