<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Каталог") — GameOnlineShop</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GameOnlineShop.styles.css" asp-append-version="true" />
    <script src="~/lib/jquery-3.7.1.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.maskedinput/1.4.1/jquery.maskedinput.min.js"></script>
    <script type="text/javascript" src="~/js/autorization.js"></script>
    <script type="text/javascript" src="~/js/search-suggest.js" asp-append-version="true"></script>
</head>
<body>
    @await Html.PartialAsync("Header")
    <main class="site-main" role="main">
        <div class="container-xl">
            @RenderBody()
        </div>
    </main>

    @await Html.PartialAsync("Footer")
    @await Html.PartialAsync("AutorizationWindow")
    @await Html.PartialAsync("_ValidationScriptsPartial")
    @await RenderSectionAsync("Scripts", required: false)
    @await RenderSectionAsync("Styles", required: false)
    @if (ViewBag.ShowModal == true)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                var loginModal = document.getElementById('loginModalWindow');
                if (loginModal && window.bootstrap) {
                    bootstrap.Modal.getOrCreateInstance(loginModal).show();
                    if (window.history.replaceState) {
                        var url = new URL(window.location.href);
                        url.searchParams.delete('login');
                        window.history.replaceState({}, '', url);
                    }
                }
            });
        </script>
    }
</body>
</html>
