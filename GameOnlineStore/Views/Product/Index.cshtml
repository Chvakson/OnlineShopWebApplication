@model ProductViewModel
@{
    ViewData["Title"] = Model.Name;
}

<article class="product-page">
    <a class="back-link" asp-area="" asp-controller="Home" asp-action="Index">← К каталогу</a>
    <div class="product-layout">
        <div class="product-media">
            <img src="@Model.ImgPath" alt="@Model.Name" onerror="this.onerror=null;this.src='/img/games/default.jpg';">
        </div>
        <div class="product-info">
            <div class="hero-tags">
                @foreach (var tag in Model.GenreTags)
                {
                    <a class="genre-tag" data-genre="@tag" asp-area="" asp-controller="Home" asp-action="Index" asp-route-genres="@tag">@tag</a>
                }
            </div>
            <h1>@Model.Name</h1>
            <p class="product-meta">
                @if (!string.IsNullOrWhiteSpace(Model.Developer))
                {
                    <span>@Model.Developer</span>
                }
                @if (Model.ReleaseYear.HasValue)
                {
                    <span>@Model.ReleaseYear</span>
                }
            </p>
            <p class="product-description">@Model.Description</p>
            <div class="product-buy">
                <span class="hero-price">@Model.Cost.ToString("N0") ₽</span>
                <a class="btn-store btn-store-lg" asp-area="" asp-controller="Cart" asp-action="Add" asp-route-productId="@Model.Id">Добавить в корзину</a>
            </div>
            <div class="product-secondary">
                <a class="btn-ghost" asp-area="" asp-controller="Favorite" asp-action="Add" asp-route-productId="@Model.Id">В избранное</a>
                <a class="btn-ghost" asp-area="" asp-controller="Compared" asp-action="Add" asp-route-productId="@Model.Id">Сравнить</a>
            </div>
        </div>
    </div>
</article>
