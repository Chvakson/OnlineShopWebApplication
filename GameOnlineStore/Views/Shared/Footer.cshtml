@{
    var year = DateTime.Now.Year;
}
<footer class="site-footer">
    <div class="container-xl footer-inner">
        <div>
            <a class="brand brand-footer" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">▶</span>
                <span class="brand-text">Game<span>Store</span></span>
            </a>
            <p class="footer-copy">Цифровой магазин игр. Покупай, сравнивай, играй.</p>
        </div>
        <div class="footer-links">
            <a asp-area="" asp-controller="Home" asp-action="Index">Каталог</a>
            <a asp-area="" asp-controller="Favorite" asp-action="Index">Избранное</a>
            <a asp-area="" asp-controller="Cart" asp-action="Index">Корзина</a>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Конфиденциальность</a>
        </div>
        <p class="footer-legal">&copy; @year GameOnlineStore</p>
    </div>
</footer>
