@model ProductViewModel
@using GameOnlineStore.Helpers
@{
    var variant = ViewData["CardVariant"] as string ?? "catalog";
    var currentGenres = Context.Request.Query["genres"].ToString();
    if (string.IsNullOrWhiteSpace(currentGenres))
    {
        currentGenres = Context.Request.Query["genre"].ToString();
    }
    var query = string.IsNullOrWhiteSpace(Context.Request.Query["query"]) ? null : Context.Request.Query["query"].ToString();
    var sort = string.IsNullOrWhiteSpace(Context.Request.Query["sort"]) ? null : Context.Request.Query["sort"].ToString();
    var pageSize = string.IsNullOrWhiteSpace(Context.Request.Query["pageSize"]) ? null : Context.Request.Query["pageSize"].ToString();
}

<article class="game-card">
    <div class="game-card__cover">
        <a class="game-card__cover-link" asp-area="" asp-controller="Product" asp-action="Index" asp-route-productId="@Model.Id">
            <img src="@Model.ImgPath" alt="@Model.Name" onerror="this.onerror=null;this.src='/img/games/default.jpg';">
            <div class="game-card__scrim"></div>
        </a>
        @if (Model.GenreTags.Any())
        {
            <div class="game-card__tags">
                @foreach (var tag in Model.GenreTags.Take(3))
                {
                    <a class="genre-tag @(GenreFilter.IsSelected(GenreFilter.Parse(currentGenres), tag) ? "is-active" : null)"
                       data-genre="@tag"
                       asp-area="" asp-controller="Home" asp-action="Index"
                       asp-route-query="@query"
                       asp-route-genres="@GenreFilter.Toggle(currentGenres, tag)"
                       asp-route-sort="@sort"
                       asp-route-pageSize="@pageSize">@tag</a>
                }
            </div>
        }
        <span class="game-card__price-chip">@Model.Cost.ToString("N0") ₽</span>
    </div>
    <div class="game-card__body">
        <a class="game-card__title" asp-area="" asp-controller="Product" asp-action="Index" asp-route-productId="@Model.Id">@Model.Name</a>
        <p class="game-card__meta">
            @if (!string.IsNullOrWhiteSpace(Model.Developer))
            {
                <span>@Model.Developer</span>
            }
            @if (Model.ReleaseYear.HasValue)
            {
                <span>@Model.ReleaseYear</span>
            }
        </p>
        <div class="game-card__actions">
            <a class="btn-store" asp-area="" asp-controller="Cart" asp-action="Add" asp-route-productId="@Model.Id">В корзину</a>
            @if (variant == "favorite")
            {
                <a class="btn-ghost" asp-area="" asp-controller="Favorite" asp-action="Remove" asp-route-productId="@Model.Id">Убрать</a>
            }
            else if (variant == "compared")
            {
                <a class="btn-ghost" asp-area="" asp-controller="Compared" asp-action="Remove" asp-route-productId="@Model.Id">Убрать</a>
            }
            else
            {
                <a class="btn-icon" asp-area="" asp-controller="Favorite" asp-action="Add" asp-route-productId="@Model.Id" title="В избранное">♡</a>
                <a class="btn-icon" asp-area="" asp-controller="Compared" asp-action="Add" asp-route-productId="@Model.Id" title="Сравнить">⇄</a>
            }
        </div>
    </div>
</article>
